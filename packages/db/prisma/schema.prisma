generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum SessionStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionState {
  WAITING_FOR_OPPONENT
  CATEGORY_SELECTION
  WAITING_FOR_CATEGORY_RESPONSE
  NUMBER_SELECTION
  WAITING_FOR_ANSWER
  TRUTH_DARE_SELECTION
  COMPLETED
  ENDED
  EXPIRED
}

enum QuestionType {
  TRUTH
  DARE
  NORMAL
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionSource {
  COMMUNITY
  ADMIN
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ReportReason {
  DUPLICATE
  WRONG_ANSWER
  INAPPROPRIATE
  SPAM
  OFF_TOPIC
  OTHER
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdPlacement {
  HERO
  SIDEBAR
  INLINE
}

enum NotificationType {
  SUBMISSION
  APPROVED
  REJECTED
  CATEGORY_REQ
  REPORT
  CONTRIBUTION
  AD
  SYSTEM
  SYSTEM_ALERT
  ADMIN_ALERT
  BROADCAST
  SESSION_INVITE
  SESSION_JOINED
  SESSION_EXPIRED
  SESSION_TIMEOUT
  SESSION_ENDED
  OPPONENT_LEFT
  GAME_ENDED
  VERIFICATION_REQUIRED
  VERIFICATION_COMPLETED
  CONTRIBUTION_REVIEW
  CAMPAIGN_COMPLETED
}

// ============================================================
// ADMINS & AUTH
// ============================================================

model Admin {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  role        Role       @default(ADMIN)
  active      Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]
  reviewedQuestions  Question[]
  reviewedContributions Contribution[]
  reviewedReports    QuestionReport[]
  reviewedCategoryRequests CategoryRequest[]
  createdCategories   Category[]
  campaigns     Campaign[]
  revenueLedgerCreated RevenueLedger[] @relation("RevenueLedgerCreator")
}

// ============================================================
// USERS (WhatsApp players)
// ============================================================

model User {
  id            String     @id @default(cuid())
  waId          String     @unique
  phone         String     @unique
  name          String?
  language      String     @default("en")
  status        UserStatus @default(ACTIVE)
  publicProfile Boolean    @default(false)
  displayName   String?
  avatarUrl     String?
  totalSessions Int        @default(0)
  totalAnswered Int        @default(0)
  totalAsked    Int        @default(0)
  firstSeenAt   DateTime   @default(now())
  lastSeenAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contributions      Contribution[]
  contributedQuestions Question[]  @relation("QuestionContributor")
  reports            QuestionReport[]
  categoryRequests   CategoryRequest[]
  badges             UserBadge[]
  notifications      Notification[]
  sessionsCreated    Session[]    @relation("CreatedSessions")
  sessionsJoined     Session[]    @relation("JoinedSessions")
  sessionsWon        Session[]    @relation("WonSessions")
  movesAsked         GameMove[]   @relation("AskedMoves")
  movesAnswered      GameMove[]   @relation("AnsweredMoves")
  monetizationGates  MonetizationGate[]
  monetizationEvents MonetizationEvent[]
  monetizationLedger RevenueLedger[]
  campaignDeliveries CampaignDelivery[]
}

// ============================================================
// CATEGORIES & QUESTIONS
// ============================================================

model Category {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  rules         String?
  icon          String         @default("Sparkles")
  color         String         @default("#2F80ED")
  gameType      String         @default("NORMAL")
  status        CategoryStatus @default(ACTIVE)
  questionCount Int            @default(0)
  playCount     Int            @default(0)
  trending      Boolean        @default(false)
  createdById   String?
  createdBy     Admin?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  questions      Question[]
  sessions       Session[]
  contributions  Contribution[]
  reports        QuestionReport[]

  @@index([status, trending])
  @@index([status, questionCount])
}

model Question {
  id              String         @id @default(cuid())
  text            String
  type            QuestionType   @default(NORMAL)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  number          Int?
  status          QuestionStatus @default(PENDING)
  source          QuestionSource @default(COMMUNITY)
  contributorId   String?
  contributor     User?          @relation("QuestionContributor", fields: [contributorId], references: [id], onDelete: SetNull)
  difficulty      Int            @default(1)
  playsCount      Int            @default(0)
  reportCount     Int            @default(0)
  aiScore         Float?
  reviewedById    String?
  reviewedBy      Admin?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  moves                     GameMove[]
  duplicateContributions    Contribution[] @relation("DuplicateOf")
  reports                   QuestionReport[]
  sessionUses               Session[]      @relation("SessionQuestion")

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([text])
  @@unique([categoryId, number])
}

// ============================================================
// GAME SESSIONS
// ============================================================

model Session {
  id                String        @id @default(cuid())
  inviteCode        String        @unique
  status            SessionStatus @default(WAITING)
  state             SessionState  @default(WAITING_FOR_OPPONENT)
  round             Int           @default(0)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pendingCategoryId String?
  categoryProposerId String?
  creatorId         String
  creator           User          @relation("CreatedSessions", fields: [creatorId], references: [id])
  joinerId          String?
  joiner            User?         @relation("JoinedSessions", fields: [joinerId], references: [id], onDelete: SetNull)
  leaverId          String?
  currentTurnUserId String?
  currentQuestionId String?
  currentNumber     Int?
  currentQuestion   Question?     @relation("SessionQuestion", fields: [currentQuestionId], references: [id], onDelete: SetNull)
  turnsPlayed       Int           @default(0)
  winnerId          String?
  winner            User?         @relation("WonSessions", fields: [winnerId], references: [id], onDelete: SetNull)
  proposalHistory   Json?
  expiresAt         DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  lastActivityAt    DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  moves GameMove[]
  monetizationGates  MonetizationGate[]
  monetizationEvents MonetizationEvent[]
  monetizationLedger RevenueLedger[]

  @@index([status, createdAt])
  @@index([inviteCode])
  @@index([creatorId, status])
  @@index([joinerId, status])
  @@index([state])
  @@index([lastActivityAt])
}

model GameMove {
  id           String       @id @default(cuid())
  sessionId    String
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question     @relation(fields: [questionId], references: [id])
  round        Int          @default(1)
  number       Int?
  askedBy      String
  askedByUser  User         @relation("AskedMoves", fields: [askedBy], references: [id])
  answeredBy   String
  answeredByUser User       @relation("AnsweredMoves", fields: [answeredBy], references: [id])
  type         QuestionType
  status       String       @default("PENDING_ANSWER")
  answer       String?
  createdAt    DateTime     @default(now())
  answeredAt   DateTime?

  @@index([sessionId])
  @@unique([sessionId, number])
  @@unique([sessionId, questionId])
  @@index([sessionId, round, status])
}

// ============================================================
// CONTRIBUTIONS / REPORTS / CATEGORY REQUESTS
// ============================================================

model Contribution {
  id              String             @id @default(cuid())
  ticket          String             @unique
  userPhone       String
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id])
  question        String
  type            QuestionType       @default(NORMAL)
  status          ContributionStatus @default(PENDING)
  aiResult        Json?
  aiScore         Float?
  duplicateOfId   String?
  duplicateOf     Question?          @relation("DuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      Admin?             @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model QuestionReport {
  id            String       @id @default(cuid())
  ticket        String       @unique
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  questionId    String?
  question      Question?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  reporterPhone String
  reporterId    String?
  reporter      User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason        ReportReason @default(OTHER)
  notes         String?
  screenshotUrl String?
  status        ReportStatus @default(OPEN)
  resolvedById  String?
  resolvedBy    Admin?       @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
}

model CategoryRequest {
  id             String                @id @default(cuid())
  name           String
  description    String
  examples       String?
  reason         String?
  requestorPhone String
  requestorId    String?
  requestor      User?                @relation(fields: [requestorId], references: [id], onDelete: SetNull)
  status         CategoryRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     Admin?                @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
}

// ============================================================
// CONTENT (FAQ, HELP, SETTINGS, ADS)
// ============================================================

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HelpArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  category  String   @default("General")
  status    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key         String   @id
  value       String
  type        String   @default("string")
  group       String   @default("general")
  description String?
  public      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Ad {
  id        String      @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  placement AdPlacement @default(HERO)
  status    Boolean     @default(true)
  order     Int         @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  clicks    Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([placement, status])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String   @default("Award")
  color       String   @default("#F2994A")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

// ============================================================
// NOTIFICATIONS / AUDIT / MISC
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  adminId   String?
  admin     Admin?           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  type      NotificationType @default(SYSTEM)
  channel   String           @default("WEB")
  status    String           @default("PENDING")
  title     String
  message   String
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([adminId, readAt])
  @@index([userId, readAt])
  @@index([userId, readAt, createdAt])
  @@index([channel, status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
}

model Upload {
  id         String   @id @default(cuid())
  url        String
  mime       String
  size       Int
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemEvent {
  id        String   @id @default(cuid())
  component String
  status    String
  message   String
  createdAt DateTime @default(now())

  @@index([component, createdAt])
}

model ProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  kind        String   @default("message")
  phone       String?
  processedAt DateTime @default(now())

  @@index([eventId])
  @@index([processedAt])
}

model JobLog {
  id         String   @id @default(cuid())
  queue      String
  jobName    String
  jobId      String?
  status     String
  data       Json?
  error      String?
  attempts   Int      @default(0)
  durationMs Int?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([queue, status, createdAt])
  @@index([status, createdAt])
  @@index([jobId])
  @@index([createdAt])
}

// ============================================================
// MONETIZATION (AD PROVIDERS, SNIPPETS, GATES, EVENTS)
// ============================================================

enum GateStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

// What type of activity produced a revenue record.
enum RevenueEventType {
  VERIFICATION
  CLICK
  IMPRESSION
  PAYOUT
  ADJUSTMENT
  OTHER
}

// How a provider is paid (drives estimated revenue).
enum ProviderRevenueModel {
  CPM
  CPC
  CPA
  FIXED
}

model AdProvider {
  id            String                @id @default(cuid())
  name          String
  type          String                @default("CUSTOM")
  description   String?
  enabled       Boolean               @default(true)
  archived      Boolean               @default(false)
  priority      Int                   @default(100)
  configuration Json?
  // Optional revenue configuration. All monetary values below are ESTIMATED
  // (rates entered by admins); confirmed figures only ever come from
  // confirmed RevenueLedger rows — never fabricated.
  revenueModel  ProviderRevenueModel  @default(CPA)
  currency      String                @default("USD")
  cpmRate       Float                 @default(0)
  cpcRate       Float                 @default(0)
  cpaRate       Float                 @default(0)
  fixedPayoutPerVerification Float     @default(0)
  estimatedPayoutPerVerification Float @default(0)
  estimatedPayoutPerClick     Float   @default(0)
  estimatedPayoutPerImpression Float  @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  snippets AdSnippet[]
  gates    MonetizationGate[]
  ledger   RevenueLedger[]

  @@index([enabled, archived, priority])
}

model AdSnippet {
  id         String      @id @default(cuid())
  name       String
  providerId String?
  provider   AdProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  type       String      @default("HTML")
  content    String?
  directLink String?
  placement  String      @default("TOP")
  enabled    Boolean     @default(true)
  archived   Boolean     @default(false)
  priority   Int         @default(100)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([enabled, archived, placement, priority])
}

model MonetizationGate {
  id            String     @id @default(cuid())
  sessionId     String
  session       Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  round         Int        @default(0)
  publicToken   String     @unique
  status        GateStatus @default(PENDING)
  unlockAt      DateTime
  expiresAt     DateTime
  verifiedAt    DateTime?
  attempts      Int        @default(0)
  code          String?
  codeHash      String?
  codeExpiresAt DateTime?
  providerId    String?
  provider      AdProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  snippetIds    Json?
  createdAt     DateTime   @default(now())

  events MonetizationEvent[]
  ledger  RevenueLedger[]

  @@index([sessionId, status])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model MonetizationEvent {
  id        String   @id @default(cuid())
  gateId    String?
  gate      MonetizationGate? @relation(fields: [gateId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  status    String   @default("recorded")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([gateId])
  @@index([sessionId, createdAt])
  @@index([userId])
  @@index([type, createdAt])
}

// ============================================================
// WHATSAPP MESSAGING
// ============================================================

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("UTILITY")
  language    String   @default("en")
  header      String?
  body        String
  footer      String?
  buttons     Json?
  variables   Json?
  status      String   @default("DRAFT")
  usageCount  Int      @default(0)
  waTemplateId String?
  metaTemplateName String?
  metaStatus  String?
  metaRejectionReason String?
  submittedAt DateTime?
  metaUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@index([status])
  @@index([category])
  @@index([metaStatus])
}

model MessageLog {
  id                 String   @id @default(cuid())
  direction          String
  phone              String
  userId             String?
  type               String
  status             String   @default("sent")
  content            Json
  templateId         String?
  campaignDeliveryId String?
  waMessageId        String?
  error              String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([direction, createdAt])
  @@index([phone])
  @@index([status])
  @@index([templateId])
  @@index([campaignDeliveryId])
  @@index([waMessageId])
}

// ============================================================
// MARKETING CAMPAIGNS
// ============================================================

model Campaign {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  messageType        String             @default("text")
  templateId         String?
  template           MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messageBody        String?
  headerText         String?
  footerText         String?
  audience           String             @default("all_users")
  audienceFilter     Json?
  scheduleType       String             @default("now")
  scheduledAt        DateTime?
  cronExpression     String?
  rateLimitPerMinute Int                @default(60)
  status             String             @default("DRAFT")
  totalRecipients    Int                @default(0)
  sentCount          Int                @default(0)
  deliveredCount     Int                @default(0)
  readCount          Int                @default(0)
  failedCount        Int                @default(0)
  skippedCount       Int                @default(0)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdById        String?
  createdBy          Admin?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  deliveries CampaignDelivery[]

  @@index([status])
  @@index([scheduleType, nextRunAt])
  @@index([createdById])
  @@index([scheduledAt])
}

model CampaignDelivery {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone         String
  status        String   @default("queued")
  messageLogId  String?
  error         String?
  attempt       Int      @default(0)
  scheduledFor  DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([campaignId, status])
  @@index([status, scheduledFor])
  @@index([userId])
}

// ============================================================
// REVENUE / MONETIZATION LEDGER
// ============================================================

model RevenueLedger {
  id                String            @id @default(cuid())
  type              String            @default("AUTO")
  // Activity that produced this row: VERIFICATION | CLICK | IMPRESSION |
  // PAYOUT | ADJUSTMENT | OTHER.
  eventType         RevenueEventType  @default(VERIFICATION)
  providerId        String?
  provider          AdProvider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  sessionId         String?
  session           Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  gateId            String?
  gate              MonetizationGate? @relation(fields: [gateId], references: [id], onDelete: SetNull)
  currency          String            @default("USD")
  revenueAmount     Float             @default(0)
  payoutAmount      Float             @default(0)
  revenueShare      Float             @default(0)
  status            String            @default("pending")
  // Estimate vs confirmed: AUTO rows and admin-entered ESTIMATED records are
  // estimates until an admin (or provider feed) confirms them.
  isEstimated       Boolean           @default(true)
  providerReference String?
  notes             String?
  metadata          Json?
  createdById       String?
  createdBy         Admin?            @relation("RevenueLedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recordedAt        DateTime          @default(now())
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([eventType, createdAt])
  @@index([isEstimated, createdAt])
  @@index([providerId, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([gateId])
}

// ============================================================
// ANALYTICS SNAPSHOTS
// ============================================================

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique
  data      Json
  createdAt DateTime @default(now())
}
