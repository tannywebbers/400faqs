# 400QUES — Environment variables
# Copy this file to `.env` at the repo root and fill in real values.
# All values here are safe placeholders for local development only.

# ---- Core ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=400QUES

# ---- Database & cache ----
DATABASE_URL=postgresql://user:password@localhost:5432/400ques
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- WhatsApp Business Cloud API ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=400ques-verify
WHATSAPP_GRAPH_VERSION=v19.0
WHATSAPP_API_BASE=https://graph.facebook.com
# REQUIRED in production — enables X-Hub-Signature-256 webhook verification
WHATSAPP_APP_SECRET=

# ---- Google AI (duplicate detection) ----
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
GOOGLE_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GOOGLE_AI_TIMEOUT_MS=15000

# ---- OpenAI (reserved; not required for the core game) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Uploads ----
UPLOADS_DIR=/absolute/path/to/400faqs/uploads
UPLOADS_PUBLIC_URL=/uploads

# ---- Admin bootstrap (used by the seed script) ----
ADMIN_EMAIL=admin@400ques.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Super Admin

# ---- Rate limiting (requests per minute) ----
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=10

# ---- Background jobs (BullMQ) ----
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
QUEUE_CONCURRENCY=4
JOB_LOG_RETENTION_DAYS=14

# ---- Optional ----
# Comma-separated allow-list for API CORS. Leave empty to accept any origin.
CORS_ORIGINS=http://localhost:3000
# Disables the whole API except webhooks + status when "true"
MAINTENANCE_MODE=false
# Run the worker process (1) vs the API server (0)
WORKER_PROCESS=0