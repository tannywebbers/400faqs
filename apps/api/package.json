{
  "name": "@400faqs/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build --workspace @400faqs/db && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
